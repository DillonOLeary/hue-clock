<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dillonoleary.screentime-capacities</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/dillonoleary/workspace/capacities_scripts/screentime_report.py</string>
        <string>push</string>
    </array>
    <!-- 23:45 nightly; launchd runs a missed interval once on wake if the Mac was asleep -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dillonoleary/Library/Logs/screentime-capacities.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dillonoleary/Library/Logs/screentime-capacities.log</string>
</dict>
</plist>
